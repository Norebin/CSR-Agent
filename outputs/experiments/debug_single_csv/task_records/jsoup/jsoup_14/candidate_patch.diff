+    // reads bytes first into a buffer, then decodes with the appropriate charset. done this way to support
+    // switching the charset midstream when a meta http-equiv tag defines the charset.
+    // todo - this is getting gnarly. needs a rewrite.
+    static Document parseByteData(ByteBuffer byteData, String charsetName, String baseUri, Parser parser) {
+        if (charsetName == null) {
+            return parseWithDetectedCharset(byteData, baseUri, parser);
+        } else {
+            Validate.notEmpty(charsetName, "Must set charset arg to character set of file to parse. Set to null to attempt to detect from HTML");
+            return parseWithCharset(byteData, charsetName, baseUri, parser);
+        }
+    }
+
+    private static Document parseWithDetectedCharset(ByteBuffer byteData, String baseUri, Parser parser) {
+        String docData = Charset.forName(defaultCharset).decode(byteData).toString();
+        Document doc = parser.parseInput(docData, baseUri);
+        Element meta = doc.select("meta[http-equiv=content-type], meta[charset]").first();
+        String foundCharset = detectCharsetFromMeta(meta);
+        if (foundCharset != null && !foundCharset.equalsIgnoreCase(defaultCharset)) {
+            foundCharset = foundCharset.trim().replaceAll("[\"']", "");
+            byteData.rewind();
+            return parseWithCharset(byteData, foundCharset, baseUri, parser);
+        }
+        return handleBOMAndParse(byteData, docData, defaultCharset, baseUri, parser);
+    }
+
+    private static String detectCharsetFromMeta(Element meta) {
+        if (meta == null) return null;
+        String foundCharset = null;
+        if (meta.hasAttr("http-equiv")) {
+            foundCharset = getCharsetFromContentType(meta.attr("content"));
+            if (foundCharset == null && meta.hasAttr("charset")) {
+                try {
+                    if (Charset.isSupported(meta.attr("charset"))) {
+                        foundCharset = meta.attr("charset");
+                    }
+                } catch (IllegalCharsetNameException e) {
+                    foundCharset = null;
+                }
+            }
+        } else {
+            foundCharset = meta.attr("charset");
+        }
+        return foundCharset;
+    }
+
+    private static Document parseWithCharset(ByteBuffer byteData, String charsetName, String baseUri, Parser parser) {
+        byteData.rewind();
+        String docData = Charset.forName(charsetName).decode(byteData).toString();
+        return handleBOMAndParse(byteData, docData, charsetName, baseUri, parser);
+    }
+
+    private static Document handleBOMAndParse(ByteBuffer byteData, String docData, String charsetName, String baseUri, Parser parser) {
+        Document doc = null;
+        if (docData.length() > 0 && docData.charAt(0) == 65279) { // UTF-8 BOM
+            byteData.rewind();
+            docData = Charset.forName(defaultCharset).decode(byteData).toString();
+            docData = docData.substring(1);
+            charsetName = defaultCharset;
+        }
+        doc = parser.parseInput(docData, baseUri);
+        doc.outputSettings().charset(charsetName);
+        return doc;
+    }