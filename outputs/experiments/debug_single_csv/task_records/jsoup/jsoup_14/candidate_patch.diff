+    static Document parseByteData(ByteBuffer byteData, String charsetName, String baseUri, Parser parser) {
+        String docData;
+        Document doc = null;
+
+        if (charsetName == null) { // determine from meta. safe parse as UTF-8
+            docData = decodeByteData(byteData, defaultCharset);
+            doc = parser.parseInput(docData, baseUri);
+            String foundCharset = detectCharsetFromMeta(doc);
+            if (foundCharset != null && !foundCharset.isEmpty() && !foundCharset.equals(defaultCharset)) {
+                foundCharset = foundCharset.trim().replaceAll("[\"']", "");
+                charsetName = foundCharset;
+                byteData.rewind();
+                docData = decodeByteData(byteData, foundCharset);
+                doc = null;
+            }
+        } else {
+            Validate.notEmpty(charsetName, "Must set charset arg to character set of file to parse. Set to null to attempt to detect from HTML");
+            docData = decodeByteData(byteData, charsetName);
+        }
+
+        // UTF-8 BOM indicator. takes precedence over everything else. rarely used. re-decodes incase above decoded incorrectly
+        if (docData.length() > 0 && docData.charAt(0) == 65279) {
+            byteData.rewind();
+            docData = decodeByteData(byteData, defaultCharset);
+            docData = docData.substring(1);
+            charsetName = defaultCharset;
+            doc = null;
+        }
+
+        if (doc == null) {
+            doc = parser.parseInput(docData, baseUri);
+            doc.outputSettings().charset(charsetName);
+        }
+        return doc;
+    }
+
+    private static String decodeByteData(ByteBuffer byteData, String charsetName) {
+        return Charset.forName(charsetName).decode(byteData).toString();
+    }
+
+    private static String detectCharsetFromMeta(Document doc) {
+        Element meta = doc.select("meta[http-equiv=content-type], meta[charset]").first();
+        if (meta == null) {
+            return null;
+        }
+        String foundCharset = null;
+        if (meta.hasAttr("http-equiv")) {
+            foundCharset = getCharsetFromContentType(meta.attr("content"));
+            if (foundCharset == null && meta.hasAttr("charset")) {
+                try {
+                    if (Charset.isSupported(meta.attr("charset"))) {
+                        foundCharset = meta.attr("charset");
+                    }
+                } catch (IllegalCharsetNameException e) {
+                    foundCharset = null;
+                }
+            }
+        } else {
+            foundCharset = meta.attr("charset");
+        }
+        return foundCharset;
+    }
